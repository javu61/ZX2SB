1 CLS
10 REM ======== EXPRESIONES, VARIABLES, PRINT ==========
20 LET A = 5
30 LET B = A + 10
40 PRINT "A=",A,"  B=",B;
50 PRINT A+B, A-B; A*B , A/B
100 REM ======== PRINT AVANZADO: AT, INK, PAPER, FLASH ==========
110 PRINT AT 3,10; INK 6; "HOLA", AT 5,10; INK 2; "MUNDO"
120 PRINT PAPER 0; BRIGHT 1; "TEST BRIGHT", FLASH 1; "FLASHING!"
200 REM ======== FUNCIONES ZX BASIC ==========
210 LET X = VAL("123")
220 LET C$ = CHR$ 65
230 LET R = RND
240 REM LET P = POINT A,B
250 REM LET T = ATTR 10,5
260 PRINT STR$ X , " ; " , SCREEN$ 0,0
270 PRINT CODE "A", LEN "HELLO"
300 REM ======== SENTENCIAS ZX BASIC NUEVAS ==========
310 CLS
320 CLEAR
330 PAUSE 20
340 BORDER 5
350 STOP
360 CONTINUE
370 RUN 100
400 REM ======== FILE COMMANDS ==========
410 SAVE "DATAFILE"
420 LOAD "START"
430 MERGE "MODULO"
440 VERIFY "CHECK"
500 REM ======== IF ==========
510 IF A < B THEN PRINT "A ES MENOR"
520 IF RND THEN PRINT "ALGO ALEATORIO"
530 IF ATTR 5,5 THEN PRINT STR$ A
600 REM ======== FOR / NEXT ==========
610 FOR I = 1 TO 5
620 PRINT I;
630 NEXT I
