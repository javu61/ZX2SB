2480 ::
2490 DEFine Function ZX2SB_BIN(a)
2500   LOCal nro, dec, bit, pot
2510   :
2520   nro = a
2530   dec = 0
2540   pot = 0
2550   REPeat loop
2560   IF nro = 0 THEN EXIT loop
2570   REMark no podemos usar bit = n DIV 10 por desbordamiento
2580   REMark QL guarda nros en notaci–n exponencial, cuidado al dividir
2590   bit = INT(((nro/10) - INT(nro/10))*10 + .1)
2600   IF (bit <> 0) AND (bit <> 1) THEN
2610     PRINT "Error en BIN, el nro ";a;" no es binario "
2620     STOP
2630   END IF
2640   nro = INT(nro/10)
2650   dec = dec + ((2^pot)*bit)
2660   pot = pot + 1
2670   END REPeat loop
2680   :
2690   RETurn dec
2700 End DEFine ZX2SB_BIN
